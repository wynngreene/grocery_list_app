      { "step_id": "spaghetti_step_001", "step_title": "Cook the Noodles", "step_image": "https://placehold.co/600x300?text=Boil+Noodles", "step_text": "Bring a large pot of salted water to a boil and cook spaghetti noodles according to package directions; drain." },
